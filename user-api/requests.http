POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "julie@gmail.com",
    "password": "J784512505802",
    "handle": "juju",
    "name": "julie monteiro",
    "roles": [
        "ROLE_USER"
    ],
    "company": "julie inc"
}


